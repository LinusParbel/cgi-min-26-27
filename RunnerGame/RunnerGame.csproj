<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="OpenTK" Version="4.9.4" />
    <ProjectReference Include="..\Engine\Engine.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Assets\**" CopyToOutputDirectory="PreserveNewest" />
    <None Update="CREDITS.md" CopyToOutputDirectory="PreserveNewest" />
    <None Update="README.md" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="Materials\**\*.glsl" />
    <None Update="Native\OpenALSoft\OpenAL32.dll" CopyToOutputDirectory="PreserveNewest" TargetPath="OpenAL32.dll" />
    <None Update="Native\OpenALSoft\COPYING" CopyToOutputDirectory="PreserveNewest" TargetPath="ThirdParty\OpenALSoft\COPYING" />
    <None Update="Native\OpenALSoft\openal-soft-1.25.2.tar.bz2" CopyToOutputDirectory="PreserveNewest" TargetPath="ThirdParty\OpenALSoft\openal-soft-1.25.2.tar.bz2" />
    <None Update="Native\OpenALSoft\README.md" CopyToOutputDirectory="PreserveNewest" TargetPath="ThirdParty\OpenALSoft\README.md" />
  </ItemGroup>
</Project>
